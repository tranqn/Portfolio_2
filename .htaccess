# Pages are prerendered to <path>/index.html (Angular static output).
# Canonical URLs have no trailing slash: /projects/coderr, /en, /en/projects/coderr.
# Apache must not append a slash to directory URLs itself (DirectorySlash Off)
# and must not list directories that have no index.html.
DirectorySlash Off
DirectoryIndex index.html
Options -Indexes

RewriteEngine On
RewriteBase /

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Let PHP files execute directly
RewriteRule \.php$ - [L]

# A typed .../index.html goes to its canonical URL (only for requests from
# outside, never for our own internal rewrite below)
RewriteCond %{THE_REQUEST} \s/+(\S*?/)?index\.html[\s?]
RewriteRule ^(.*?)/?index\.html$ /$1 [L,R=301]

# Trailing slash goes to the form without (the root / stays)
RewriteRule ^(.+)/$ /$1 [L,R=301]

# Serve the prerendered page for a clean URL
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)$ $1/index.html [L]

# Everything else that does not exist is a real 404 with the prerendered page
ErrorDocument 404 /404/index.html

# Ensure PHP is handled
AddHandler application/x-httpd-php .php

# MIME types
AddType image/svg+xml .svg
AddType application/javascript .js
AddType text/css .css
AddType application/json .json
AddType font/ttf .ttf
AddType font/woff2 .woff2
AddType video/mp4 .mp4
AddType image/gif .gif
AddType image/png .png
AddType image/jpeg .jpg .jpeg
AddType image/webp .webp
AddType image/avif .avif

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/ttf "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  # index.html and the translations must never be stale after a deploy
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>
